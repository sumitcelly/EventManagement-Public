  KEY `IdOrganizer1_idx` (`CustomerId`),
  KEY `IdUser1_idx` (`UserId`),
  KEY `IX_TeamMembers_InvitationToken` (`InvitationToken`),
  CONSTRAINT `IdOrganizer1` FOREIGN KEY (`CustomerId`) REFERENCES `eventorganizer` (`CustomerId`),
  CONSTRAINT `IdUser1` FOREIGN KEY (`UserId`) REFERENCES `eventuser` (`UserId`)
) ENGINE=InnoDB AUTO_INCREMENT=174 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci;
