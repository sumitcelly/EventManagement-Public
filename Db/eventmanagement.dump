--
-- Table structure for table `eventuser`
--

DROP TABLE IF EXISTS `eventuser`;
/*!40101 SET @saved_cs_client     = @@character_set_client */;
/*!50503 SET character_set_client = utf8mb4 */;
CREATE TABLE `eventuser` (
  `UserId` int NOT NULL AUTO_INCREMENT,
  `Email` varchar(200) NOT NULL,
  `Sms` varchar(45) DEFAULT NULL,
  `FullName` varchar(200) DEFAULT NULL,
  `Password` varchar(200) DEFAULT NULL,
  `CreatedAt` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP,
  `ModifiedAt` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP,
  `City` varchar(200) DEFAULT NULL,
  `Country` varchar(200) DEFAULT NULL,
  `StreetAddress` varchar(200) DEFAULT NULL,
  `ZipCode` varchar(45) DEFAULT NULL,
  `LoginLocation` varchar(200) DEFAULT NULL,
  `PasswordSalt` varchar(45) DEFAULT NULL,
  PRIMARY KEY (`UserId`),
  KEY `email` (`Email`)
) ENGINE=InnoDB AUTO_INCREMENT=164 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci;
/*!40101 SET character_set_client = @saved_cs_client */;

