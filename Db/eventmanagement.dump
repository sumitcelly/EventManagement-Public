--
-- Table structure for table `logincodes`
--

DROP TABLE IF EXISTS `logincodes`;
/*!40101 SET @saved_cs_client     = @@character_set_client */;
/*!50503 SET character_set_client = utf8mb4 */;
CREATE TABLE `logincodes` (
  `id` int unsigned NOT NULL AUTO_INCREMENT,
  `emailaddress` varchar(256) NOT NULL,
  `usedat` datetime DEFAULT NULL,
  `securitycode` varchar(32) NOT NULL,
  `createdat` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP,
  `expiresat` datetime NOT NULL,
  `requestip` varchar(45) DEFAULT NULL,
  PRIMARY KEY (`id`),
  KEY `idx_code` (`securitycode`),
  KEY `idx_expires` (`expiresat`)
) ENGINE=InnoDB AUTO_INCREMENT=203 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci;
/*!40101 SET character_set_client = @saved_cs_client */;

