--
-- Table structure for table `salesorder`
--

DROP TABLE IF EXISTS `salesorder`;
/*!40101 SET @saved_cs_client     = @@character_set_client */;
/*!50503 SET character_set_client = utf8mb4 */;
CREATE TABLE `salesorder` (
  `OrderId` int NOT NULL AUTO_INCREMENT,
  `CustomerId` int NOT NULL,
  `EventId` int NOT NULL,
  `DeliveryType` varchar(45) DEFAULT NULL,
  `CreatedAt` datetime NOT NULL,
  `ModifiedAt` datetime DEFAULT NULL,
  `SalesOrderCode` varchar(256) CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci DEFAULT NULL,
  `UserId` int NOT NULL,
  `SalesOrderStatus` varchar(45) DEFAULT NULL,
  `StripeSessionId` varchar(256) DEFAULT NULL,
  `ReservedAt` datetime DEFAULT NULL,
  `PaymentIntentId` varchar(256) DEFAULT NULL,
  `RefundId` varchar(256) DEFAULT NULL,
  `RefundAmount` decimal(10,2) DEFAULT NULL,
  `RefundedAt` datetime DEFAULT NULL,
  `SalesOrderTotal` decimal(10,2) DEFAULT NULL,
  `PlatformFees` decimal(10,2) DEFAULT NULL,
  `TotalFees` decimal(10,2) DEFAULT NULL,
  `SalesTax` decimal(10,2) DEFAULT NULL,
  `TaxCollected` tinyint DEFAULT '0',
  PRIMARY KEY (`OrderId`),
  KEY `EventOrganizerId2_idx` (`CustomerId`),
  KEY `EventIdRef1_idx` (`EventId`),
  KEY `UserIdRef2_idx` (`UserId`),
  CONSTRAINT `EventIdRef1` FOREIGN KEY (`EventId`) REFERENCES `events` (`EventId`),
  CONSTRAINT `EventOrganizerId2` FOREIGN KEY (`CustomerId`) REFERENCES `eventorganizer` (`CustomerId`),
  CONSTRAINT `UserIdRef3` FOREIGN KEY (`UserId`) REFERENCES `eventuser` (`UserId`)
) ENGINE=InnoDB AUTO_INCREMENT=876 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci;
/*!40101 SET character_set_client = @saved_cs_client */;

--
-- Dumping data for table `salesorder`
--

LOCK TABLES `salesorder` WRITE;
/*!40000 ALTER TABLE `salesorder` DISABLE KEYS */;
