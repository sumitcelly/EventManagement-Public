DROP TABLE IF EXISTS `emailtransactionlog`;
/*!40101 SET @saved_cs_client     = @@character_set_client */;
/*!50503 SET character_set_client = utf8mb4 */;
CREATE TABLE `emailtransactionlog` (
  `id` bigint NOT NULL AUTO_INCREMENT,
  `recipientemail` varchar(255) NOT NULL,
  `emailtype` varchar(255) NOT NULL,
  `refid` int DEFAULT NULL,
  `sendermessageid` varchar(100) DEFAULT NULL,
  `status` varchar(100) NOT NULL,
  `createdat` datetime(3) NOT NULL,
  `sentat` datetime(3) DEFAULT NULL,
  `errormessage` text,
  PRIMARY KEY (`id`),
  KEY `idx_email` (`recipientemail`),
  KEY `idx_sendermessageid` (`sendermessageid`)
) ENGINE=InnoDB AUTO_INCREMENT=492 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci;
/*!40101 SET character_set_client = @saved_cs_client */;

