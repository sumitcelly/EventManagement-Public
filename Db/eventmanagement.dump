--
-- Table structure for table `eventsalesitem`
--

DROP TABLE IF EXISTS `eventsalesitem`;
/*!40101 SET @saved_cs_client     = @@character_set_client */;
/*!50503 SET character_set_client = utf8mb4 */;
CREATE TABLE `eventsalesitem` (
  `TicketId` int NOT NULL AUTO_INCREMENT,
  `EventId` int NOT NULL,
  `TicketScanned` tinyint(1) DEFAULT NULL,
  `TicketCode` varchar(256) CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci DEFAULT NULL,
  `SalesOrderId` int DEFAULT NULL,
  `EventItemTypeId` int NOT NULL,
  `UserId` int NOT NULL,
  `CreatedAt` datetime NOT NULL,
  `ModifiedAt` datetime DEFAULT NULL,
  `PricePaid` decimal(10,2) DEFAULT '0.00',
  `TicketStatus` varchar(256) DEFAULT NULL,
  PRIMARY KEY (`TicketId`),
  UNIQUE KEY `TicketCode_UNIQUE` (`TicketCode`),
  KEY `EventId_idx` (`EventId`),
  KEY `SalesorderRef2_idx` (`SalesOrderId`),
  KEY `EventItemTypeRef1_idx` (`EventItemTypeId`),
  KEY `AttendeeId_idx` (`UserId`),
  CONSTRAINT `EventId` FOREIGN KEY (`EventId`) REFERENCES `events` (`EventId`),
  CONSTRAINT `EventItemTypeRef1` FOREIGN KEY (`EventItemTypeId`) REFERENCES `eventitemtype` (`EventItemTypeId`),
  CONSTRAINT `SalesorderRef2` FOREIGN KEY (`SalesOrderId`) REFERENCES `salesorder` (`OrderId`) ON DELETE CASCADE,
  CONSTRAINT `UserIdRef1` FOREIGN KEY (`UserId`) REFERENCES `eventuser` (`UserId`)
) ENGINE=InnoDB AUTO_INCREMENT=1190 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci;
/*!40101 SET character_set_client = @saved_cs_client */;

