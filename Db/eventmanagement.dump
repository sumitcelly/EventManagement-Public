DROP TABLE IF EXISTS `eventorganizer`;
/*!40101 SET @saved_cs_client     = @@character_set_client */;
/*!50503 SET character_set_client = utf8mb4 */;
CREATE TABLE `eventorganizer` (
  `CustomerId` int NOT NULL AUTO_INCREMENT,
  `OrganizationName` varchar(256) NOT NULL,
  `OrganizerStreetAddress` varchar(500) NOT NULL,
  `OrganizerCity` varchar(256) DEFAULT NULL,
  `OrganizerState` varchar(2) DEFAULT NULL,
  `OrganizerZipCode` varchar(20) DEFAULT NULL,
  `OrganizerWebsite` varchar(256) NOT NULL,
  `OrganizerEventBaseUrl` varchar(256) NOT NULL,
  `OrganizerDescription` text NOT NULL,
  `OrganizerInstagram` varchar(256) DEFAULT NULL,
  `OrganizerFacebook` varchar(256) DEFAULT NULL,
  `OrganizerPhone` varchar(20) DEFAULT NULL,
  `OrganizerEmail` varchar(256) DEFAULT NULL,
  `OrganizerCountry` varchar(256) NOT NULL COMMENT 'This is the customer table where the eventOrganizer really referers to the company and not the individual organizer',
  `CreatedAt` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP,
  `ModifiedAt` datetime DEFAULT CURRENT_TIMESTAMP,
  `StripeAccountId` varchar(100) DEFAULT NULL,
  `StripeConnectStatus` varchar(45) DEFAULT NULL,
  `OrganizerAboutMe` varchar(255) DEFAULT NULL,
  `OrganizerFullAddress` varchar(255) DEFAULT NULL,
  `OrganizerImageUrl` varchar(256) DEFAULT NULL,
  `OrganizerX` varchar(255) DEFAULT NULL,
  `RefundsAllowed` tinyint DEFAULT NULL,
  PRIMARY KEY (`CustomerId`)
) ENGINE=InnoDB AUTO_INCREMENT=100 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci;
/*!40101 SET character_set_client = @saved_cs_client */;

